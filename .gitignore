# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore
/.vscode
.gitignore
*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# SQLite na web: copiado de node_modules/sql.js pelo "postinstall"
/public/assets/sql-wasm.wasm

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

